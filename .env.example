# FastAPI persistence API (used by src/lib/api.ts).
# Copy to .env.local if you need to override the default.
VITE_API_URL=http://127.0.0.1:8000

# Supabase — browser-safe values only. NEVER put secret/service-role keys in VITE_* vars.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server / Edge / integration tests only (do not prefix with VITE_; do not commit real values)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Optional — required for `supabase link` / `db push` to hosted projects
# SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
# SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Set to 1 to enable hosted integration tests (schema 0001 + 202609170001–0005 must exist).
# Probe first: npm run supabase:probe
SUPABASE_INTEGRATION=0

# data.gov.in (Open Government Data Platform India) — two SEPARATE
# integrations read data.gov.in config, with DIFFERENT variable names. Do not
# assume one configures the other.

# 1. supabase/functions/live-scheme-retrieval — the DEPLOYED Edge Function
#    the browser actually calls (via src/assistant/liveRetrieval.ts). Set
#    these as Supabase secrets, not in this file:
#      supabase secrets set DATA_GOV_IN_API_KEY=... DATA_GOV_IN_RESOURCE_ID=... --project-ref YOUR_PROJECT_REF
#    The base URL (https://api.data.gov.in) is fixed in that function's own
#    source, not read from env — so a leaked/rotated key can never be pointed
#    at a different, untrusted host by changing configuration alone.
# DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
# DATA_GOV_IN_RESOURCE_ID=YOUR_VERIFIED_RESOURCE_ID

# 2. src/backend/services/officialSource/dataGovInAdapter.ts — a separate,
#    backend-only "Phase 3 discovery" adapter (see docs/BACKEND_INTEGRATION.md).
#    NOT reachable from the browser today and NOT the deployed Edge Function
#    above — setting these does NOT configure live-scheme-retrieval, and
#    setting DATA_GOV_IN_RESOURCE_ID above does NOT configure this adapter.
#    Server-only; never prefix with VITE_. Without both of THESE set, the
#    adapter is cleanly "unconfigured" and discovery falls back to the
#    verified_local NSFDC fixture only.
# DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
# DATA_GOV_IN_SCHEME_RESOURCE_ID=YOUR_VERIFIED_RESOURCE_ID
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# URL of a developer-run relay/proxy for Gemini Live voice — NOT a Gemini API
# key. Safe to expose in the browser: it is just an endpoint address, the same
# way VITE_SUPABASE_URL is safe. OPTIONAL — with it unset (the default), the
# app runs exactly as before: the Gemini Live voice provider correctly
# reports itself unavailable, no crash, no fake "connected" state. This repo
# does not ship the actual relay/proxy backend — see
# docs/voice-session-architecture.md and src/assistant/voice/geminiLiveConfig.ts
# for the two supported backend patterns and why a raw Gemini API key must
# NEVER go in this file or anywhere else browser-reachable.
# VITE_GEMINI_LIVE_PROXY_URL=

# ---------------------------------------------------------------------------
# Gemini Live voice (real-time bidirectional audio assistant)
# ---------------------------------------------------------------------------
# SERVER-ONLY. Set this as a Supabase Edge Function secret, NEVER as a VITE_
# var and never in this file if this file is ever bundled:
#
#   supabase secrets set GEMINI_API_KEY=your_key
#   supabase functions deploy gemini-live-token
#
# The browser never receives this key. It calls the gemini-live-token Edge
# Function, which exchanges the key for a short-lived, model-constrained
# ephemeral token (Google's documented pattern for client-side Live API
# use), and the browser connects to Gemini directly with that token.
# GEMINI_API_KEY=

# Optional per-deployment override of the Live model. Defaults to
# gemini-3.8-live; must stay in sync with GEMINI_LIVE_DEFAULT_MODEL in
# src/assistant/voice/geminiLiveProtocol.ts.
# GEMINI_LIVE_MODEL=gemini-3.8-live
#
# With GEMINI_API_KEY unset, the token function returns 503, voice reports
# itself unavailable, and the TEXT assistant continues to work unchanged.
