# FastAPI persistence API (used by src/lib/api.ts).
# Copy to .env.local if you need to override the default.
VITE_API_URL=http://127.0.0.1:8000

# Supabase — browser-safe values only. NEVER put the service-role key in VITE_* vars.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server / Edge / integration tests only (do not prefix with VITE_; do not commit real values)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Set to 1 after `npm run supabase:start` + db reset to enable integration tests
SUPABASE_INTEGRATION=0
