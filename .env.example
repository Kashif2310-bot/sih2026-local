# Supabase — browser-safe values only. NEVER put secret/service-role keys in VITE_* vars.
# VITE_SUPABASE_ANON_KEY is Supabase's public "anon" key, not a secret — it is
# safe to ship in browser code by design and is constrained server-side by Row
# Level Security. Both variables are OPTIONAL — with neither set, the app runs
# exactly as it always has: the curated local scheme dataset only, no
# Supabase, no live retrieval, no errors.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server / Edge / integration tests only (do not prefix with VITE_; do not commit real values)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Optional — required for `supabase link` / `db push` to hosted projects
# SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
# SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Set to 1 to enable integration tests once keys + migrations are applied
SUPABASE_INTEGRATION=0

# Phase 3 — backend's own official government source retrieval adapter
# (src/backend/services/officialSource/dataGovInAdapter.ts, data.gov.in OGD
# API). Server-only; never prefix with VITE_. Without both set, the adapter
# is cleanly "unconfigured" and discovery falls back to the verified_local
# NSFDC fixture only — no live scraping, no invented resource id shipped here.
# Distinct from DATA_GOV_IN_API_KEY/DATA_GOV_IN_RESOURCE_ID below, which
# configure a DIFFERENT module (the live-scheme-retrieval Edge Function) —
# do not conflate the two resource-id variable names.
# DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
# DATA_GOV_IN_SCHEME_RESOURCE_ID=YOUR_VERIFIED_RESOURCE_ID
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# The following configure the live-retrieval Edge Function
# (supabase/functions/live-scheme-retrieval) specifically, and must be set as
# Supabase secrets on your project, e.g.:
#   supabase secrets set DATA_GOV_IN_API_KEY=your-key-here
#   supabase secrets set DATA_GOV_IN_RESOURCE_ID=your-resource-id-here
# Get a free API key by registering at https://data.gov.in/user/register.
# See README.md for what this key does and does not enable.
# DATA_GOV_IN_API_KEY=
# DATA_GOV_IN_RESOURCE_ID=

# URL of a developer-run relay/proxy for Gemini Live voice — NOT a Gemini API
# key. Safe to expose in the browser: it is just an endpoint address, the same
# way VITE_SUPABASE_URL is safe. OPTIONAL — with it unset (the default), the
# app runs exactly as before: the Gemini Live voice provider correctly
# reports itself unavailable, no crash, no fake "connected" state. This repo
# does not ship the actual relay/proxy backend — see
# docs/voice-session-architecture.md and src/assistant/voice/geminiLiveConfig.ts
# for the two supported backend patterns and why a raw Gemini API key must
# NEVER go in this file or anywhere else browser-reachable.
# VITE_GEMINI_LIVE_PROXY_URL=
