# FastAPI persistence API (used by src/lib/api.ts).
# Copy to .env.local if you need to override the default.
VITE_API_URL=http://127.0.0.1:8000

# Supabase — browser-safe values only. NEVER put the service-role key here or in Vite.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server / Edge Functions only (do not prefix with VITE_; do not commit real values)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
